{
  "name": "tahachelly-com",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/sync-assets.mjs && astro dev",
    "build": "npm run check:i18n && node scripts/sync-assets.mjs && astro build && node scripts/security-headers.mjs && node scripts/mirror-build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:i18n": "node scripts/check-i18n.mjs",
    "translations:edit": "node scripts/edit-translations.mjs",
    "weblate:start": "node scripts/weblate.mjs start",
    "weblate:stop": "node scripts/weblate.mjs stop",
    "weblate:status": "node scripts/weblate.mjs status",
    "weblate:credentials": "node scripts/weblate.mjs credentials",
    "weblate:connect": "node scripts/connect-weblate.mjs",
    "translations:pull": "node scripts/pull-weblate.mjs",
    "translations:push": "node scripts/push-weblate.mjs",
    "test:security": "node --test scripts/translation-markup.test.mjs"
  },
  "dependencies": {
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^6.0.3",
    "wrangler": "4.151.0"
  },
  "overrides": {
    "fast-uri": "^3.1.9",
    "undici@>=7 <8": "7.30.1"
  }
