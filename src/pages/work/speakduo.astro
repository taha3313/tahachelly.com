---
import Base from '../../layouts/Base.astro';
import en from '../../data/i18n/en.json';
const sections = ['Context', 'Practice', 'Feedback', 'Role', 'Outcome'];
const copy: Record<string, string> = en;
---
<Base title="SpeakDuo case study | Taha Chelly" description={en.speakduoCaseSummary} article>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <article class="engineering-article">
    <div class="article-top-link"><a class="notebook-back" href="/#work" data-i18n="speakduoCaseBack">{en.speakduoCaseBack}</a></div>
    <div class="article-heading">
      <p class="section-kicker">SpeakDuo / <span data-i18n="speakduoCaseLabel">{en.speakduoCaseLabel}</span></p>
      <h1 id="hero-title" tabindex="-1" data-i18n="speakduoCaseTitle">{en.speakduoCaseTitle}</h1>
      <p class="article-deck" data-i18n="speakduoCaseSummary">{en.speakduoCaseSummary}</p>
      <div class="article-byline"><img src="/taha.webp" alt="" width="44" height="44" /><div><span>Taha Chelly · <span data-i18n="role">{en.role}</span></span><span data-i18n="employmentDates">{en.employmentDates}</span></div></div>
    </div>
    <div class="article-body">
      <div class="article-prose">{sections.map(section => <section id={`case-${section.toLowerCase()}`}><h2 data-i18n={`speakduoCase${section}Title`}>{copy[`speakduoCase${section}Title`]}</h2><p data-i18n={`speakduoCase${section}`}>{copy[`speakduoCase${section}`]}</p></section>)}</div>
      <div class="article-return"><a class="secondary-button" href="/#work" data-i18n="speakduoCaseBack">{en.speakduoCaseBack}</a></div>
    </div>
  </article>
</Base>
