---
import en from '../../data/i18n/en.json';
import ProjectToolbar from '../../components/ProjectToolbar.astro';
import ProjectNote from '../../components/ProjectNote.astro';
import Engineering from '../../components/Engineering.astro';
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';
const project = projects[0];
const brandIcons: Record<string, string> = { 'React 19': 'react', TypeScript: 'typescript', Python: 'python', FastAPI: 'fastapi', Docker: 'docker' };
const stackIcons: Record<string, string> = { Vite: 'bolt', 'Tailwind CSS 4': 'layers', 'ONNX Runtime': 'chip', 'faster-whisper': 'waveform', Render: 'cloud' };
---
<Base title="Quranic Shazam | Taha Chelly" description="Qur’an audio recognition: identify reciters and discover verses with React, FastAPI, ONNX Runtime, and Whisper. Screenshots, architecture, source code, and live demo." project>
  <section class="project-hero" aria-labelledby="hero-title">
    <a class="text-link" href="/#projects" data-i18n="backProjects">← All projects</a>
    <p class="intro" data-i18n="projectCategory">AUDIO · AI · WEB</p>
    <h1 id="hero-title" tabindex="-1">Quranic <span>Shazam.</span></h1>
    <p class="hero-description" data-i18n="projectSummary">Discover who is reciting and which verse you’re hearing. An audio recognition app for Qur’an recitation, with live listening and file uploads.</p>
  </section>
  <ProjectToolbar demo={project.demo} github={project.github} />
  <ProjectNote project="quranic-shazam" />
  <section class="project-section" aria-labelledby="screenshots-title">
    <div class="section-heading"><span class="section-kicker" data-i18n="screenshotsKicker">A LOOK INSIDE</span><h2 id="screenshots-title" data-i18n="screenshotsTitle">Two ways to explore a recitation.</h2></div>
    <div class="screenshot-grid">{project.screenshots.map((src, i) => <figure><a href={src} target="_blank" rel="noopener noreferrer"><img src={src} alt={i === 0 ? en.reciterScreenshotAlt : en.verseScreenshotAlt} data-i18n-alt={i === 0 ? 'reciterScreenshotAlt' : 'verseScreenshotAlt'} width="1280" height="900" loading="lazy" /></a><figcaption><Icon name={i === 0 ? "microphone" : "book"} /><span data-i18n={i === 0 ? 'reciterCaption' : 'verseCaption'}>{i === 0 ? 'Reciter recognition — upload audio or listen live.' : 'Verse discovery — find the surah and ayah from a recitation.'}</span></figcaption></figure>)}</div>
  </section>
  <section class="project-section" aria-labelledby="approach-title"><div class="section-heading"><span class="section-kicker" data-i18n="approachKicker">BEHIND THE EXPERIENCE</span><h2 id="approach-title" data-i18n="approachTitle">From sound to a meaningful match.</h2></div><div class="project-features"><article><span class="feature-mark"><Icon name="microphone" /><span class="feature-number">01</span></span><h3 data-i18n="reciterTitle">Recognize the reciter</h3><p data-i18n="reciterDetail">An ECAPA-TDNN model creates a voice embedding. ONNX Runtime runs inference, then cosine similarity ranks matches against profiles for 20 reciters.</p></article><article><span class="feature-mark"><Icon name="book" /><span class="feature-number">02</span></span><h3 data-i18n="verseTitle">Find the verse</h3><p data-i18n="verseDetail">A Quran-tuned Whisper model transcribes the Arabic audio. Normalized text is matched against 6,236 verses to find likely surah and ayah matches.</p></article><article><span class="feature-mark"><Icon name="waveform" /><span class="feature-number">03</span></span><h3 data-i18n="contextTitle">Listen for more context</h3><p data-i18n="contextDetail">When a verse match is ambiguous, progressive listening gathers more audio context. Uncertain results stay marked as uncertain.</p></article></div></section>
  <section class="project-section" aria-labelledby="stack-title"><div class="section-heading"><span class="section-kicker" data-i18n="stackKicker">BUILT WITH</span><h2 id="stack-title" data-i18n="stackTitle">The technology behind it.</h2></div><ul class="stack-tags stack-large">{project.stack.map(tool => <li>{brandIcons[tool] ? <img class="toolkit-icon" src={`/icons/${brandIcons[tool]}.svg`} width="16" height="16" alt="" aria-hidden="true" /> : <Icon name={stackIcons[tool]} />}<span>{tool}</span></li>)}</ul><div class="stack-details"><p><Icon name="code" /><span data-i18n="frontendDetail">Frontend: React 19 and TypeScript, built with Vite and Tailwind CSS 4. Browser microphone capture and file uploads connect to the API.</span></p><p><Icon name="server" /><span data-i18n="backendDetail">Backend: Python and FastAPI, with WebSockets for live reciter recognition. ONNX Runtime handles speaker embeddings; faster-whisper and CTranslate2 handle verse transcription.</span></p><p><Icon name="cloud" /><span data-i18n="deployDetail">Delivery: Docker containers on Render, with Nginx serving the frontend. GitHub Actions checks the backend and frontend before deploying affected services.</span></p></div></section>
  <Engineering project="quranic-shazam" />
  <section class="project-outro"><h2 data-i18n="tryTitle">Hear it. Discover it.</h2><a class="button" href={project.demo} target="_blank" rel="noopener noreferrer"><Icon name="globe" /><span data-i18n="liveDemo">Try the live demo</span><span aria-hidden="true">↗</span></a></section>
</Base>
