---
import Engineering from '../../components/Engineering.astro';
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';
const project = projects.find(item => item.slug === 'qafiya')!;
const description = 'An Arabic poetry workshop for classical meter, rhyme, scansion, and local CPU vocalization. Explore Qafiya, built with React, FastAPI, PyArud, and ONNX Runtime.';
const captions = ['qafiyaCaptionDesk', 'qafiyaCaptionMobile'];
const features = [
  { icon: 'book', title: 'qafiyaAnalysisTitle', detail: 'qafiyaAnalysisDetail', number: '01' },
  { icon: 'waveform', title: 'qafiyaTashkeelTitle', detail: 'qafiyaTashkeelDetail', number: '02' },
  { icon: 'code', title: 'qafiyaDraftTitle', detail: 'qafiyaDraftDetail', number: '03' },
];
---
<Base title="Qafiya · قافية | Taha Chelly" description={description} project projectName="Qafiya · قافية" repository={project.github}>
  <section class="project-hero" aria-labelledby="hero-title">
    <a class="text-link" href="/#projects" data-i18n="backProjects">← All projects</a>
    <p class="intro" data-i18n="qafiyaCategory">LANGUAGE · POETRY · AI</p>
    <h1 id="hero-title" tabindex="-1">Qafiya <span lang="ar" dir="rtl">قَافِيَة.</span></h1>
    <p class="hero-description" data-i18n="qafiyaSummary">An Arabic poetry workshop for classical meter, rhyme, readable scansion, and local vocalization.</p>
    <div class="hero-actions">
      <a class="button" href={project.demo} target="_blank" rel="noopener noreferrer"><Icon name="globe" /><span data-i18n="liveDemo">Try the live demo</span><span aria-hidden="true">↗</span></a>
      <a class="secondary-button" href={project.github} target="_blank" rel="noopener noreferrer"><Icon name="code" /><span data-i18n="sourceCode">View on GitHub</span><span aria-hidden="true">↗</span></a>
    </div>
    <p class="intro" data-i18n="generationPaused">Analysis is available in the live demo. AI generation is currently disabled.</p>
  </section>
  <section class="project-section" aria-labelledby="screenshots-title">
    <div class="section-heading"><span class="section-kicker" data-i18n="screenshotsKicker">A LOOK INSIDE</span><h2 id="screenshots-title" data-i18n="qafiyaApproachTitle">From a written verse to its rhythm.</h2></div>
    <div class="screenshot-grid">{project.screenshots.map((src, i) => <figure class={i === 1 ? 'mobile-screenshot' : undefined}><a href={src} target="_blank" rel="noopener noreferrer"><img src={src} alt={`Qafiya ${i === 0 ? 'desktop' : 'mobile'} interface showing Arabic poetry analysis`} width={i === 0 ? 1440 : 390} height={i === 0 ? 1461 : 2388} loading="lazy" /></a><figcaption><Icon name={i === 0 ? 'book' : 'waveform'} /><span data-i18n={captions[i]}>{i === 0 ? 'Writing desk — choose a classical meter and rhyme letter, then inspect the verse.' : 'Responsive Arabic-first poetry analysis on mobile.'}</span></figcaption></figure>)}</div>
  </section>
  <section class="project-section" aria-labelledby="approach-title">
    <div class="section-heading"><span class="section-kicker" data-i18n="approachKicker">BEHIND THE EXPERIENCE</span><h2 id="approach-title" data-i18n="qafiyaApproachTitle">From a written verse to its rhythm.</h2></div>
    <div class="project-features">{features.map(feature => <article><span class="feature-mark"><Icon name={feature.icon} /><span class="feature-number">{feature.number}</span></span><h3 data-i18n={feature.title}>{feature.title === 'qafiyaAnalysisTitle' ? 'Analyze classical meter' : feature.title === 'qafiyaTashkeelTitle' ? 'Complete vocalization locally' : 'Drafting is experimental'}</h3><p data-i18n={feature.detail}>{feature.detail === 'qafiyaAnalysisDetail' ? 'Check Arabic verses against 16 classical meters with PyArud. Explore the صدر and عجز, binary scansion, feet, and the requested rawi.' : feature.detail === 'qafiyaTashkeelDetail' ? 'A bundled 4.8 MB libtashkeel ONNX model fills missing vowel marks on the CPU. Supplied vowels remain authoritative; analysis does not call an LLM.' : 'An optional provider adapter drafts poems and targets revisions at failed verses while preserving accepted text. Generation is currently disabled on the public demo.'}</p></article>)}</div>
  </section>
  <section class="project-section" aria-labelledby="stack-title">
    <div class="section-heading"><span class="section-kicker" data-i18n="stackKicker">BUILT WITH</span><h2 id="stack-title" data-i18n="stackTitle">The technology behind it.</h2></div>
    <ul class="stack-tags stack-large">{project.stack.map(tool => <li><Icon name={tool.includes('ONNX') ? 'chip' : tool.includes('FastAPI') || tool.includes('Python') ? 'server' : tool.includes('Cloudflare') || tool === 'Render' || tool === 'Docker' ? 'cloud' : tool === 'PyArud' ? 'waveform' : 'code'} /><span>{tool}</span></li>)}</ul>
    <div class="stack-details"><p><Icon name="code" /><span data-i18n="qafiyaFrontend">Frontend: React 19, TypeScript, and Vite, with a responsive Arabic RTL interface.</span></p><p><Icon name="server" /><span data-i18n="qafiyaBackend">Backend: Python 3.12, FastAPI, PyArud, NumPy, and CPU ONNX Runtime. A single worker shares a bounded inference session.</span></p><p><Icon name="cloud" /><span data-i18n="qafiyaDeploy">Hosting: Cloudflare Pages frontend and Render Docker API. GitHub Actions checks the frontend, backend, and production container.</span></p></div>
  </section>
  <Engineering project="qafiya" />
  <section class="project-outro"><h2 data-i18n="qafiyaTryTitle">Explore meter and rhyme.</h2><a class="button" href={project.demo} target="_blank" rel="noopener noreferrer"><Icon name="globe" /><span data-i18n="liveDemo">Try the live demo</span><span aria-hidden="true">↗</span></a></section>
</Base>
