---
import en from '../data/i18n/en.json';
import { projects } from '../data/projects';
---
<section class="projects" id="projects" aria-labelledby="projects-title">
  <div class="section-heading"><span class="section-kicker" data-i18n="projectsKicker">PERSONAL PROJECTS</span><h2 id="projects-title" data-i18n="projectsTitle">Selected projects</h2></div>
  <div class="project-grid">{projects.map(project => <article class="project-card">
    <a class="project-preview" href={`/projects/${project.slug}/`}><img src={project.screenshots[0]} alt={`${project.name}: project preview`} width={project.slug === 'qafiya' ? 1440 : 1280} height={project.slug === 'qafiya' ? 1461 : 900} loading="lazy" /><span class="preview-label" data-i18n="viewProject">Explore project ↗</span></a>
    <div class="project-copy"><span class="section-kicker" data-i18n={project.categoryKey}>{en[project.categoryKey as keyof typeof en]}</span><h3><a href={`/projects/${project.slug}/`}>{project.name}</a></h3><p data-i18n={project.summaryKey}>{project.slug === 'qafiya' ? 'An Arabic poetry workshop for classical meter, rhyme, scansion, and local CPU vocalization.' : 'Discover who is reciting and which verse you’re hearing. An audio recognition app for Qur’an recitation, with live listening and file uploads.'}</p><div class="project-evidence"><strong data-i18n={project.evidenceKey}>{en[project.evidenceKey]}</strong><p data-i18n={project.evidenceContextKey}>{en[project.evidenceContextKey]}</p></div><ul class="stack-tags" aria-label="Technology" data-i18n-aria="technologyLabel">{project.cardStack.map(tool => <li>{tool}</li>)}</ul><a class="text-link" href={`/projects/${project.slug}/`} data-i18n="viewProject">Explore project ↗</a></div>
  </article>)}</div>
</section>
