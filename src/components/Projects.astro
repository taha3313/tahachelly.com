---
import { projects } from '../data/projects';
---
<section class="projects" id="projects" aria-labelledby="projects-title">
  <div class="section-heading"><span class="section-kicker" data-i18n="projectsKicker">SELECTED PROJECTS</span><h2 id="projects-title" data-i18n="projectsTitle">Ideas brought to life.</h2></div>
  {projects.map(project => <article class="project-card">
    <a class="project-preview" href={`/projects/${project.slug}/`}><img src={project.screenshots[0]} alt="Quranic Shazam reciter recognition interface" width="1280" height="900" loading="lazy" /><span class="preview-label" data-i18n="viewProject">Explore project ↗</span></a>
    <div class="project-copy"><span class="section-kicker" data-i18n="projectCategory">AUDIO · AI · WEB</span><h3><a href={`/projects/${project.slug}/`}>{project.name}</a></h3><p data-i18n="projectSummary">Discover who is reciting and which verse you’re hearing. An audio recognition app for Qur’an recitation, with live listening and file uploads.</p><ul class="stack-tags" aria-label="Technology">{['React', 'TypeScript', 'FastAPI', 'ONNX', 'Whisper'].map(tool => <li>{tool}</li>)}</ul><a class="text-link" href={`/projects/${project.slug}/`} data-i18n="viewProject">Explore project ↗</a></div>
  </article>)}
</section>
