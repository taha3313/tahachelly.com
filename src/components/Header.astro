---
import en from '../data/i18n/en.json';
const inNotebook = Astro.url.pathname.startsWith('/writing/');
---
<header id="top" tabindex="-1">
  <a class="brand" href="/" aria-label="Taha Chelly home" data-i18n-aria="homeLabel">Taha Chelly<span aria-hidden="true">●</span></a>
  <div class="header-right">
    <button class="menu-toggle" type="button" aria-controls="main-navigation" aria-expanded="false" aria-label="Navigation menu" data-i18n-aria="menuLabel"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path class="menu-lines" d="M4 6h16M4 12h16M4 18h16"/><path class="menu-close" d="m6 6 12 12M6 18 18 6"/></svg></button>
    <nav id="main-navigation" aria-label="Main navigation">
      <a href="/#about" data-i18n="aboutTitle">{en.aboutTitle}</a>
      <a href="/#work" data-i18n="workTitle">{en.workTitle}</a>
      <a href="/#projects" data-i18n="projectsTitle">{en.projectsTitle}</a>
      <a href="/#writing" data-i18n="writingTitle" aria-current={inNotebook ? 'location' : undefined}>{en.writingTitle}</a>
      <a href="/#community" data-i18n="communityTitle">{en.communityTitle}</a>
      <a href="/#contact" data-i18n="contactTitle">{en.contactTitle}</a>
    </nav>
    <label class="language-picker"><span class="visually-hidden" data-i18n="languageLabel">Language</span><select class="language-select" aria-label="Language"><option value="en">EN</option><option value="ar">العربية</option><option value="es">ES</option><option value="de">DE</option><option value="fr">FR</option><option value="it">IT</option><option value="zh">中文</option><option value="ja">日本語</option></select></label>
    <button class="theme-toggle" type="button" aria-label="Switch to dark mode" title="Switch to dark mode"><svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.5 14.3A8.7 8.7 0 0 1 9.7 3.5a8.7 8.7 0 1 0 10.8 10.8Z"/></svg><svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5"/></svg></button>
  </div>
</header>
