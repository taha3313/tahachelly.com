---
import { stories } from '../data/stories';
import en from '../data/i18n/en.json';
---
<section class="writing project-section" id="writing" aria-labelledby="writing-title">
  <div class="section-heading"><span class="section-kicker" data-i18n="writingKicker">{en.writingKicker}</span><h2 id="writing-title" data-i18n="writingTitle">{en.writingTitle}</h2></div>
  <div class="notes-grid">{stories.map((story,i) => <article class="engineering-note"><span class="section-kicker">{story.project}</span><h3><a href={`/writing/${story.slug}/`} data-i18n={`story${i}Title`}>{story.title}</a></h3><p data-i18n={`story${i}Summary`}>{story.summary}</p><a class="text-link" href={`/writing/${story.slug}/`} data-i18n="readNote">{en.readNote}</a></article>)}</div>
  <a class="text-link notebook-browse" href="/writing/" data-i18n="browseNotebook">{en.browseNotebook}</a>
</section>
