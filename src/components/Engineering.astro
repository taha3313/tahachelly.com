---
import { stories } from '../data/stories';
import en from '../data/i18n/en.json';
interface Props { project: 'qafiya' | 'quranic-shazam'; }
const { project } = Astro.props;
const i = project === 'qafiya' ? 1 : 0;
const story = stories[i];
const sections = [0,1,3];
---
<section class="project-section" aria-labelledby="decisions-title">
  <div class="section-heading"><span class="section-kicker" data-i18n="decisionsKicker">{en.decisionsKicker}</span><h2 id="decisions-title" data-i18n="decisionsTitle">{en.decisionsTitle}</h2></div>
  <div class="project-features">{sections.map(j => <article><h3 data-i18n={`story${i}Section${j}Title`}>{story.sections[j].title}</h3><p data-i18n={`story${i}Section${j}Text`}>{story.sections[j].text}</p></article>)}</div>
  <p class="evidence-link"><a href={story.source} data-i18n="evidenceCaption">{en.evidenceCaption}</a></p>
</section>
